# Normalize line endings: LF in the repository, regardless of the editor or
# platform a contributor works on. Without this, a Windows checkout writes CRLF
# back and whole files show up as rewritten in diff and blame.
* text=auto eol=lf

# Source and config: always LF.
*.js      text eol=lf
*.json    text eol=lf
*.scss    text eol=lf
*.html    text eol=lf
*.md      text eol=lf
.nvmrc    text eol=lf
.gitignore text eol=lf

# Binary assets: never touched.
*.png     binary
*.jpg     binary
*.gif     binary
